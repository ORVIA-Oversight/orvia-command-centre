# ORVIA Command base
COMMAND_BASE_URL=https://command.orvia.org.uk
COMMAND_PRIVATE_MODE=true
COMMAND_USERNAME=
COMMAND_PASSWORD=

# Supabase server-side
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Command Mail token vault
# Use a long random secret or a 32-byte base64 value. Never commit the real value.
MAIL_TOKEN_ENCRYPTION_KEY=

# Microsoft Graph OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations

# Google Gmail / Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI drafting (optional until reply generation is enabled)
OPENAI_API_KEY=
MAIL_AI_MODEL=


# DeerFlow work-floor runtime (optional)
# Keep DeerFlow subordinate to IRIS. Do not expose the runtime directly to end users.
DEERFLOW_BASE_URL=
DEERFLOW_API_KEY=
DEERFLOW_RUN_PATH=/api/runs

# ARIA visible avatar inside Command (stable hosted image URL)
NEXT_PUBLIC_ARIA_AVATAR_URL=


# HeyGen ARIA
# ARIA avatar/look in HeyGen: 1be4fda28fbd70b0cd75181a1c5deef4
# British ARIA voice used by the approved website intro:
HEYGEN_API_KEY=
HEYGEN_ARIA_VOICE_ID=FfFqvaTg0z8GSMLMTWln
